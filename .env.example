# ─── Database: Supabase Postgres ───
# Supabase → Project Settings → Database → Connection string → "Prisma" tab.
# DATABASE_URL = pooled (Transaction, port 6543, ends with ?pgbouncer=true)
# DIRECT_URL   = direct (Session, port 5432) — used by prisma migrate / db push
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── NextAuth ───
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# In Vercel set this to your deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
