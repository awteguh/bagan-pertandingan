# ─── Local development (SQLite file) ───
# Used only when TURSO_DATABASE_URL is NOT set.
DATABASE_URL="file:./dev.db"

# ─── Production / Turso (set these in Vercel) ───
# From: turso db show <db> --url   and   turso db tokens create <db>
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# ─── NextAuth ───
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# In Vercel set this to your deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
